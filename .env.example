# Supabase project. Get these from Supabase Dashboard > Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service role key. Server only, never exposed to the browser. Used by the
# voice webhooks to write across clinics, bypassing Row Level Security.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Shared secret that the voice platform must send in the Authorization header
# (Bearer token) when calling the internal webhooks. Generate a long random
# string, for example: openssl rand -hex 32
TELMA_WEBHOOK_TOKEN=replace-with-a-long-random-secret


# ============================================================================
# INSCRIÇÃO (/inscricao)
#
# Every variable below is optional, and the sign-up works without any of them.
# Each one that is missing switches that part into demo mode: a fictional phone
# number, no charge, the welcome email printed to the server log. That is on
# purpose. The flow has to be demonstrable to a client before there is a funded
# Twilio account or a live Stripe product, and it has to be testable without
# either.
# ============================================================================

# Where this panel is reachable. Used for the links in the welcome email and for
# Stripe's return URL. Falls back to the request's own host, which is right in
# development and wrong behind a proxy that rewrites it.
NEXT_PUBLIC_DASHBOARD_URL=https://painel.telmaatende.com

# The landing's origin. The sign-up links back to it, and the voice samples on
# step 4 are served from it rather than copied into this repo.
NEXT_PUBLIC_SITE_URL=https://telmaatende.com

# --- Twilio -----------------------------------------------------------------
# Both halves or neither: half a credential is a misconfiguration, and it must
# not silently fall back to handing out fictional numbers. Without them, step 5
# still works and the number it returns is fake, flagged in the activity log.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Where a bought number should send its calls. Set it in the same breath as the
# credentials: a number that exists and rings nowhere is worse than no number,
# because the clinic hands it out.
TWILIO_VOICE_WEBHOOK_URL=

# --- Stripe -----------------------------------------------------------------
# Without a key, step 6 creates the clinic and charges nothing. With one, the
# clinic is created 'pausada' and only the webhook below activates it.
STRIPE_SECRET_KEY=
# From Stripe Dashboard > Developers > Webhooks, for the endpoint pointing at
# /api/webhook/stripe. Without it every webhook is rejected, which is the safe
# default: that endpoint is outside the session gate.
STRIPE_WEBHOOK_SECRET=
#
# The prices themselves are NOT here. They live in `plans.stripe_price_id` and
# `addons.stripe_price_id` in the database, which is already the one place the
# price list lives. A price id in an environment variable is a second price
# list, and the second one is always the one that is wrong.

# --- ElevenLabs ---------------------------------------------------------------
# A chave da conta. Sem ela, o passo 4 mostra os quatro nomes de marcador em vez
# das vozes reais, e a inscrição continua a funcionar.
#
# Scopes mínimos ao criar a chave (Developers > API Keys > Restrict Key):
#   Voices        Read     para listar as vozes do passo 4
#   ElevenAgents  Read     para o script de setup encontrar os ids dos agentes
# Tudo o resto pode ficar em No Access. A inscrição não gera áudio: as amostras
# do passo 4 são as que a ElevenLabs já aloja, e ouvir uma não gasta créditos.
ELEVENLABS_API_KEY=

# O agente que atende. **Um só**, para toda a gente.
#
# Não um por especialidade nem um por idioma. Esta aplicação foi construída à
# volta de um agente genérico que chama /api/clinic-context no início de cada
# conversa e é informado de quem é a clínica, do que vende, em que língua atende
# e a que horas abre. Tudo o que de outra forma estaria cozido num prompt são
# dados, e é esse endpoint que os serve.
#
# Descubra o id com:  node scripts/elevenlabs-setup.mjs
ELEVENLABS_AGENT_ID=

# A voz. **Uma por idioma**, e fixa por clínica.
#
# Duas regras que parecem contradizer-se e não. O sotaque tem de ser local: uma
# clínica em Lisboa cuja rececionista soa brasileira, ou uma em Barcelona cuja
# rececionista soa mexicana, tem uma rececionista que os pacientes ouvem como
# estrangeira. E a Telma não pode mudar de voz a meio de uma chamada, ou deixa
# de ser uma pessoa.
#
# As duas valem porque a voz é escolhida a partir do idioma em que a clínica
# atende e depois fica fixa. Uma clínica de Barcelona que também atende em
# inglês atende num inglês com sotaque espanhol, que é como soa uma
# rececionista bilingue em Barcelona.
#
# Uma voz única para todos foi tentada primeiro e os dados da conta mataram-na:
# das 32 vozes, exatamente UMA é português europeu e todas as outras vozes
# portuguesas são brasileiras. Nenhuma voz é ao mesmo tempo pt-PT e es-ES.
#
# Descubra os ids, já filtrados por sotaque, com:
#   node scripts/elevenlabs-setup.mjs
ELEVENLABS_VOICE_ID_PT=
ELEVENLABS_VOICE_ID_ES=
ELEVENLABS_VOICE_ID_EN=

# Catalão: nenhuma voz do catálogo o declara. Deixe vazio e usa a espanhola,
# que é o mais próximo que existe.
ELEVENLABS_VOICE_ID_CA=

# Usada quando o idioma não tem voz própria definida acima. Deixe vazia: uma voz
# sem sotaque definido a servir de rede foi o que fez a Telma soar
# latino-americana em Barcelona, e em silêncio.
ELEVENLABS_VOICE_ID=

# A família de modelos, e tem de ser a MESMA que está selecionada no agente
# (ElevenLabs > Agent > TTS model family). Se divergirem, a amostra que a
# clínica ouve na inscrição não é a voz que os pacientes vão ouvir, e a
# pré-visualização deixa de servir para o que existe.
#
# O valor por defeito é deliberado: o sotaque peninsular da Carolina e o
# português europeu da Benedita estão verificados na família v2 e NÃO em v3.
# Se mudar o agente para V3 Conversational, mude isto também e oiça antes de
# dar por bom o sotaque.
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# --- Email ------------------------------------------------------------------
# Without a key the welcome email is printed to the server log in development,
# and refused outright in production rather than dropping a temporary password
# into a log nobody treats as a credential store.
RESEND_API_KEY=
ONBOARDING_EMAIL_FROM=Telma <ola@telmaatende.com>
